{
  "name": "@elem-app/arcade",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "arcade": "./dist/app.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./backends": {
      "types": "./dist/backends.d.ts",
      "default": "./dist/backends.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && node --env-file-if-exists=.env dist/app.js",
    "typecheck": "tsc --noEmit && pnpm -C web run typecheck",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project unit",
    "eval": "pnpm build && node --env-file-if-exists=.env dist/eval-main.js",
    "prepare": "pnpm -C web install --frozen-lockfile && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@anthropic-ai/sdk": "^0.98.0",
    "@earendil-works/pi-agent-core": "0.80.6",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents": "^0.11.6",
    "jsonc-parser": "^3.3.1",
    "openai": "^6.39.1",
    "zod": "^4.4.3",
    "@elem-app/arc": "git+ssh://git@github.com/elem-app/arc.git#v0.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
