{
  // Recommended local-machine deployment template. Copy and adjust it for the
  // service environment; omitted settings use Arcade's built-in defaults.

  // -- Paths --
  // Root for durable run state, generated artifacts, and diagnostics. Mount or
  // back up this directory when state must survive service replacement.
  // "dataDir": ".arcade-data",

  // Arc bundle path. Relative paths are searched under the service working
  // directory and under workspaces supplied by connecting clients.
  // "arcsDir": ".arcade/arcs",

  // -- Workers --
  // Each slot selects an available backend; fields beside "backend" configure
  // that backend.
  // "default" applies to roles without an explicit entry in "roles".
  // "fastTrigger" handles trigger-stage semantic checks; use a low-latency backend.
  "workers": {
    "default": {
      "backend": "openai-sdk",
      "timeoutMs": 43200000,
      "apiKeySecret": "openai.api_key",
      // "sessionCache": {
      //   "enabled": true,
      //   "maxPreparedStarts": 4,
      //   "idleTtlMs": 300000,
      //   "initializeTimeoutMs": 30000,
      // },
    },
    "fastTrigger": { "backend": "claude-sdk-tst" },
    // "roles": {
    //   "researcher": { "backend": "researcher-custom", "model": "..." },
    // },
  },

  // -- Secrets --
  // Map logical secret names used by worker slots to environment variable names;
  // secret values stay out of this file. Local "pnpm start" and "pnpm test" load
  // the gitignored .env file. Other launchers should provide process environment variables.
  "secrets": {
    "provider": "env",
    "env": {
      "openai.api_key": "ARCADE_OPENAI_API_KEY",
    },
  },

  // -- Arc host --
  // "arcHost": {
  //   "snapshotRuntimeCacheSize": 32    // Max entries per snapshot-data/runtime cache (0 disables retention).
  // },

  // -- Logging --
  // "logging": {
  //   "level": "info",                  // "silent" | "info" | "debug"
  //   "format": "json"                  // "json" | "pretty"
  // },
}
